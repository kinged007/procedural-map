{
  "name": "@fieldwork/procedural-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic semantic world generation with a Canvas map studio.",
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./rendering": {
      "types": "./dist/rendering/CanvasRenderer.d.ts",
      "import": "./dist/rendering/CanvasRenderer.js"
    }
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:lib": "tsc -p tsconfig.build.json",
    "build:demo": "vite build",
    "build": "npm run build:lib && npm run build:demo",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build:lib && node --test tests/*.test.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build:demo"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1"
  }
}
